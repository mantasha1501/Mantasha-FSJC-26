    public static void main(String[] args) {
        
        // Creating and displaying student 1
        Student s1 = new Student("Mantasha", "251P065", 8.9);
        s1.display();

        // Creating and displaying student 2
        Student s2 = new Student("Noushaba", "251P055", 8.6);
        s2.display();

        // Creating and displaying student 3
        Student s3 = new Student("Armaan", "251P035", 9.0);
        s3.display();
    }
