// Blueprint class to represent a Student
class Student {
    // Private instance variables for encapsulation
    private String name;
    private String uin;
    private double cgpa;

    // Parameterized constructor to initialize student attributes
    public Student(String name, String uin, double cgpa) {
        this.name = name;
        this.uin = uin;
        this.cgpa = cgpa;
    }

    // Method to display student information
    public void display() {
        System.out.println("Name : " + name);
        System.out.println("UIN  : " + uin);
        System.out.println("CGPA : " + cgpa);
        System.out.println("-------------------------"); // Formatting separator
    }
}
